.venv/
__pycache__/
*.pyc
# Every .env variant, not just the literal name. `.env` alone let
# `.env.bak-20260909`, `.env.save`, `.env.old` and an editor's `.env~` through --
# each one a full set of live credentials, one `git add -A` from the history.
# The negation keeps the template, which carries no secrets and must stay tracked.
.env*
!.env.example
uvicorn.log
gaps.jsonl
results.json
run.txt
messages.jsonl
bot.log
syn30_run.json
run*.txt
baseline_pre_merge.json
feedback.jsonl
graphify-out/
baseline_87.json
question_vectors.json
retrieval_snapshot.json
# Per-tenant bot logs, written by supervise.py.
logs/

# Crash output. bot.err was TRACKED and empty, which is the dangerous
# combination: the next unhandled traceback lands in a file git is already
# watching, and `git add -A` publishes a stack trace with paths, queries and
# whatever a customer typed to trigger it.
*.err

# GENERATED FROM REAL CUSTOMER MESSAGES by harvest.py -- its own docstring says
# "real questions from real people". Nothing imports it, it is regenerable in
# one command, and in a PUBLIC repo it is other people's words. The stubs are
# for local triage, not for publication.
questions_harvested.py
