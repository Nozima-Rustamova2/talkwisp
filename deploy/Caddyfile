# /etc/caddy/Caddyfile
#
# One host, one origin. The landing page, the product and the API all live on
# talkwisp.uz, which is why there is no CORS anywhere in this codebase and no
# cross-domain cookie problem. An api. subdomain would have created both.
#
# Cloudflare is in front on Full (strict), so the origin must present a
# certificate Cloudflare trusts. It presents a Cloudflare ORIGIN CERTIFICATE --
# see the tls line below, and read the comment there before touching it.

talkwisp.uz {
	# ------------------------------------------------------------------
	# DO NOT DELETE THIS LINE TO "LET CADDY HANDLE CERTIFICATES
	# AUTOMATICALLY". It is not redundant. Removing it re-enables ACME and
	# deadlocks the site.
	#
	# Why: Let's Encrypt's HTTP-01 challenge fetches
	# http://talkwisp.uz/.well-known/acme-challenge/... DNS points at
	# Cloudflare, so Cloudflare answers, not this box. With Always Use HTTPS
	# on, Cloudflare 301s to https:// before the origin sees anything; Let's
	# Encrypt follows; Cloudflare then dials the origin on 443 under Full
	# (strict), where Caddy has no certificate yet -- because obtaining one
	# is what it was doing. Origin handshake fails, 526, challenge fails.
	# A deadlock that reads as "Caddy is broken" and is not.
	#
	# The alternative was grey-clouding during issuance. It works ONCE.
	# Renewal sixty days later runs the same challenge against the same
	# proxied domain, fails unattended, and the certificate expires at
	# whatever hour it happens to be -- an outage scheduled for a date
	# nobody wrote down.
	#
	# A Cloudflare Origin Certificate is valid fifteen years, is exactly what
	# Full (strict) checks for, and needs no ACME at all. It is trusted ONLY
	# by Cloudflare: hitting 35.204.36.184 directly gives a certificate
	# warning. That is intended. Nothing should reach the origin directly.
	#
	# Regenerate from: Cloudflare -> SSL/TLS -> Origin Server -> Create
	# Certificate. Files are root-owned 0600.
	# ------------------------------------------------------------------
	tls /etc/caddy/origin.pem /etc/caddy/origin.key

	encode zstd gzip

	header {
		# Cloudflare terminates TLS in front of this, but the header has to
		# originate here or it is a promise nobody made.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Do not advertise the server software.
		-Server
	}

	# --- the product -------------------------------------------------------
	# handle_path strips the /app prefix, so /app/assets/x.js resolves to
	# assets/x.js inside dist. That has to match vite.config.ts's base: "/app/"
	# -- if the two ever disagree, every asset 404s in production while `vite
	# dev` works perfectly. Same trap the base setting was written to avoid.
	redir /app /app/ 301
	handle_path /app/* {
		root * /home/talkwisp/talkwisp/frontend/dist
		# The SPA uses HASH routing, so a deep link never reaches the server
		# and this fallback only serves the mount root. It is here so a
		# mistyped asset path returns the app rather than a bare 404 page.
		try_files {path} /index.html
		file_server
	}

	# --- landing page and the three legal pages ----------------------------
	# Plain static files, rendered once from prototype/Landing Page.dc.html.
	# Deliberately NOT part of the Vite build and never served through it.
	#
	# NOTE: site/ does not exist until the landing page has been rendered. Until
	# then these paths 404. If you want the interim behaviour instead -- root
	# redirecting to /app/ -- comment out this whole block and uvicorn's own
	# `/` route will answer, because it already returns RedirectResponse("/app/").
	# A NAMED MATCHER, not three paths on the handle line. `handle` takes
	# exactly one matcher token; `handle /privacy* /terms* /data-deletion*`
	# is a parse error ("wrong argument count"), not a list. Caddy 2.11.4.
	@legal path /privacy* /terms* /data-deletion*
	handle @legal {
		root * /home/talkwisp/talkwisp/site
		try_files {path}.html {path}
		file_server
	}
	handle / {
		root * /home/talkwisp/talkwisp/site
		rewrite * /index.html
		file_server
	}

	# `handle /` matches the EXACT path / and nothing else, so the landing
	# page's own assets fell through to the API and 404'd. The font still
	# rendered -- the browser fell back through `Manrope, system-ui,
	# sans-serif` to a system face -- so the page looked right and quietly was
	# not in the typeface the design specifies. Measured on the live site:
	# /fonts/manrope.css 404, /favicon.svg 404, /icons.svg 404.
	#
	# Listed explicitly rather than served as a catch-all file root, so this
	# block cannot shadow an API path added later.
	@siteassets path /fonts/* /favicon.svg /icons.svg /robots.txt
	handle @siteassets {
		root * /home/talkwisp/talkwisp/site
		file_server
	}

	# Port 80 stays open and Caddy keeps redirecting it to 443, even though
	# validation no longer needs it. Someone typing `talkwisp.uz` with no
	# scheme should land on HTTPS rather than on nothing, and Cloudflare
	# handles that better when the origin cooperates than when it refuses.
	# The explicit tls line above disables automatic CERTIFICATE MANAGEMENT
	# only; the http->https redirect is separate and still applies.

	# --- everything else is the API ----------------------------------------
	# uvicorn binds 127.0.0.1:8200 and must never bind 0.0.0.0: on a public VM
	# that makes the origin reachable on 8200 directly, in plaintext, bypassing
	# both Caddy and Cloudflare at once.
	handle {
		reverse_proxy 127.0.0.1:8200 {
			# Cloudflare rewrites the client IP, so the app sees Cloudflare's
			# address unless the real one is passed through. Nothing reads this
			# yet; the /auth/request rate limiter will, and a limiter keyed on
			# the wrong IP throttles every visitor at once.
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		}
	}
}
