# /etc/systemd/system/talkwisp-bot.service
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now talkwisp-bot
#   journalctl -u talkwisp-bot -f
#
# ONE UNIT PER BOT TOKEN. Telegram allows a single getUpdates consumer per
# token, and a second one does not fail cleanly -- the two processes steal each
# other's updates and messages vanish. So this unit serves exactly one business.
#
# The second business gets talkwisp-bot@.service (a template) or its own unit,
# NOT a second copy of this one pointed at the same token. Ten businesses today
# means ten poll loops at roughly 66 MB each; webhooks collapse that to zero
# extra processes and are worth doing before the tenth customer, not after.

[Unit]
# StartLimit* belong in [Unit]. They sat in [Service], where systemd ignores
# them with 'Unknown key name' in the journal -- so the restart-storm guard
# this file thought it had was never in force.
StartLimitIntervalSec=60
StartLimitBurst=5
Description=Talkwisp Telegram agent bot
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=exec
# talkwisp-svc, not the login user. See talkwisp-api.service for the full
# reasoning: talkwisp is in GCP's google-sudoers group, that membership is
# maintained by google-guest-agent from SSH-key metadata, and fighting it does
# not hold. This process handles messages from strangers on the internet and
# has no business being able to become root.
User=talkwisp-svc
Group=talkwisp-svc
WorkingDirectory=/home/talkwisp/talkwisp
# ONE secrets file, the repo's .env, and never a second copy. migrate.py,
# seed.py and every check script read it through load_dotenv(), so a separate
# /etc/talkwisp/env would be two files holding the same values -- and they
# drift, failing at runtime rather than at edit time. It is 0600 talkwisp:talkwisp.
# Not in this unit and not in .bashrc: unit files are world-readable under
# /etc/systemd/system.
EnvironmentFile=/home/talkwisp/talkwisp/.env

# NOT `uv run`. Two reasons, and the second is why this is the fix rather
# than a workaround.
#
# `uv run` re-resolves the environment on every start and needs a WRITABLE
# CACHE at ~/.cache/uv. ProtectHome=read-only makes that fail:
#
#   Could not acquire lock -> Read-only file system (os error 30)
#   at path "/home/talkwisp/.cache/uv/.tmpXXXXXX"
#
# The tempting fixes are ReadWritePaths=/home/talkwisp/.cache or a
# UV_CACHE_DIR elsewhere. Both keep a resolver on the startup path of a
# long-running service, doing work it does not need, and both widen the
# sandbox to accommodate it. Calling the venv's entry point directly removes
# the requirement instead: no resolver, no cache, no lock, nothing to write.
#
# Verified rather than assumed -- with HOME pointed at a nonexistent path,
# `.venv/bin/python -c "import app.main"` still imports. The interpreter is a
# symlink into ~/.local/share/uv, and ProtectHome=read-only permits reads.
#
# The venv must exist: `uv sync` once, by hand, at deploy time.
#
# -u matters here more than for the API. bot.py's startup prints are not
# flushed, so without it a working bot looks like a hung one for the first
# thirty seconds -- long enough to make someone restart a healthy process.
ExecStart=/home/talkwisp/talkwisp/.venv/bin/python -u bot.py

Restart=always
RestartSec=5

Environment=PYTHONUNBUFFERED=1

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# messages.jsonl is appended to on every customer message.
# The app writes exactly three files at runtime, all appended, all in the
# repo root: gaps.jsonl, feedback.jsonl, messages.jsonl. Uploaded documents
# are bytea in Postgres and never touch the filesystem. So this one carve-out
# is the whole write surface -- checked by grep, not assumed.
ReadWritePaths=/home/talkwisp/talkwisp

[Install]
WantedBy=multi-user.target
