# /etc/systemd/system/talkwisp-api.service
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now talkwisp-api
#   systemctl status talkwisp-api
#   journalctl -u talkwisp-api -f     <- the magic links print here

[Unit]
Description=Talkwisp API and owner screens
# Postgres is a hard dependency, not a soft one: app/db.py opens the pool and
# runs assert_app_role() during startup, so a boot before Postgres is a boot
# that fails. Restart=always would then retry, but noisily and for no reason.
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=exec
User=talkwisp
Group=talkwisp
WorkingDirectory=/home/talkwisp/talkwisp

# ONE secrets file, the repo's .env, and never a second copy. migrate.py,
# seed.py and every check script read it through load_dotenv(), so a separate
# /etc/talkwisp/env would be two files holding the same values -- and they
# drift, failing at runtime rather than at edit time. It is 0600 talkwisp:talkwisp.
# Not in this unit and not in .bashrc: unit files are world-readable under
# /etc/systemd/system.
EnvironmentFile=/home/talkwisp/talkwisp/.env

# NOT `uv run`. Two reasons, and the second is why this is the fix rather
# than a workaround.
#
# `uv run` re-resolves the environment on every start and needs a WRITABLE
# CACHE at ~/.cache/uv. ProtectHome=read-only makes that fail:
#
#   Could not acquire lock -> Read-only file system (os error 30)
#   at path "/home/talkwisp/.cache/uv/.tmpXXXXXX"
#
# The tempting fixes are ReadWritePaths=/home/talkwisp/.cache or a
# UV_CACHE_DIR elsewhere. Both keep a resolver on the startup path of a
# long-running service, doing work it does not need, and both widen the
# sandbox to accommodate it. Calling the venv's entry point directly removes
# the requirement instead: no resolver, no cache, no lock, nothing to write.
#
# Verified rather than assumed -- with HOME pointed at a nonexistent path,
# `.venv/bin/python -c "import app.main"` still imports. The interpreter is a
# symlink into ~/.local/share/uv, and ProtectHome=read-only permits reads.
#
# The venv must exist: `uv sync` once, by hand, at deploy time.
#
# --host 127.0.0.1 is load-bearing. Binding 0.0.0.0 exposes the origin on 8200
# with no TLS and no proxy, which undoes Caddy and Cloudflare together.
ExecStart=/home/talkwisp/talkwisp/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8200

# A crash that needs a human is a crash that lasts hours. Both processes have
# been OOM-killed before, and an OOM kill is exactly the case this covers.
Restart=always
RestartSec=5
# ... but do not spin forever on a configuration error. Five failures inside a
# minute means the problem is not transient, and a tight restart loop hides the
# real error in a wall of identical journal entries.
StartLimitIntervalSec=60
StartLimitBurst=5

# Unbuffered, so journalctl shows startup lines as they happen rather than in a
# block once the buffer fills. The bot's startup prints are the known case.
Environment=PYTHONUNBUFFERED=1

# Modest hardening. Not a sandbox -- the app legitimately reads the repo and
# appends to the three .jsonl logs in it -- but there is no reason for it to
# see /home elsewhere, write to /usr, or gain privileges.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# The app writes exactly three files at runtime, all appended, all in the
# repo root: gaps.jsonl, feedback.jsonl, messages.jsonl. Uploaded documents
# are bytea in Postgres and never touch the filesystem. So this one carve-out
# is the whole write surface -- checked by grep, not assumed.
ReadWritePaths=/home/talkwisp/talkwisp

[Install]
WantedBy=multi-user.target
