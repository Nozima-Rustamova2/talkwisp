# The APP role. Non-superuser, owns nothing, and every query it runs is filtered
# to one business by row-level security (migrations/0007_multitenancy.sql).
#
# It must NOT be postgres. A superuser bypasses RLS entirely -- not partially,
# not with a warning -- so every tenancy policy would be inert while the
# database still looked correctly configured. app/db.py refuses to start on a
# superuser connection for exactly this reason.
#
# migrate.py creates this role and sets this password, reading both from here,
# so there is one place the app credential is written down.
DATABASE_URL=postgresql://talkwisp_app:CHANGEME@localhost:5433/talkwisp

# The OWNER role. Used by migrate.py and nothing else: migrations alter tables
# and manage roles, which the app role deliberately cannot do.
ADMIN_DATABASE_URL=postgresql://postgres:CHANGEME@localhost:5433/talkwisp

# Embeddings and the answering model. https://aistudio.google.com/apikey
# Comma-separated. Free-tier quota is per key per model per day, so several keys
# are several daily budgets; a 429 rotates to the next one automatically.
GEMINI_API_KEYS=CHANGEME,CHANGEME
# Single-key fallback, used only when GEMINI_API_KEYS is unset.
GEMINI_API_KEY=CHANGEME
# Pinned on purpose: changing it requires a full check_answer.py re-run.
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_PROVIDER=gemini

# From @BotFather: /newbot. This is one BUSINESS's agent bot, not Talkwisp's
# platform bot -- the platform bot signs web logins and must never be a
# customer's. migrate.py copies this onto the business row the first time it
# runs; after that the row is the source of truth and the bot resolves which
# business it serves from the token itself. These two stay here only to
# bootstrap a new install.
TELEGRAM_BOT_TOKEN=CHANGEME
# Your numeric Telegram user id. Optional until step 23.
TELEGRAM_OWNER_ID=
