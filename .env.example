# The APP role. Non-superuser, owns nothing, and every query it runs is filtered
# to one business by row-level security (migrations/0007_multitenancy.sql).
#
# It must NOT be postgres. A superuser bypasses RLS entirely -- not partially,
# not with a warning -- so every tenancy policy would be inert while the
# database still looked correctly configured. app/db.py refuses to start on a
# superuser connection for exactly this reason.
#
# migrate.py creates this role and sets this password, reading both from here,
# so there is one place the app credential is written down.
DATABASE_URL=postgresql://talkwisp_app:CHANGEME@localhost:5433/talkwisp

# The OWNER role. Used by migrate.py and nothing else: migrations alter tables
# and manage roles, which the app role deliberately cannot do.
ADMIN_DATABASE_URL=postgresql://postgres:CHANGEME@localhost:5433/talkwisp

# ---------------------------------------------------------------------------
# TWO CREDENTIALS, DELIBERATELY. Do not tidy them into one.
#
#   GENERATION  answers customer questions. May run on AI Studio or Vertex AI,
#               chosen by LLM_PROVIDER below. This is the expensive call --
#               ~4,000 input tokens plus ~350 output per message.
#   EMBEDDINGS  always AI Studio, permanently, whatever LLM_PROVIDER says.
#               Moving them would invalidate every similarity number this
#               project has measured -- the 0.55 floor, the FACT_WINDOW
#               distribution, the cached question vectors -- because a vector
#               from a different serving stack is not comparable to the ones
#               already in the database, and nothing would error to say so.
#
# So GEMINI_API_KEYS below is required even when generation is on Vertex.
# app/llm.py's check_configured() enforces that at startup regardless of
# LLM_PROVIDER; the comment there explains why it must not sit behind the
# provider branch.
# ---------------------------------------------------------------------------

# --- embeddings: ALWAYS needed. https://aistudio.google.com/apikey ---
# Comma-separated. Free-tier quota is per key per model per day, so several keys
# are several daily budgets; a 429 rotates to the next one automatically. With
# billing enabled a 429 means a RATE limit rather than an exhausted daily
# budget, and rotating to a second paid key just spends faster -- worth
# revisiting that branch once billing is on.
GEMINI_API_KEYS=CHANGEME,CHANGEME
# Single-key fallback, used only when GEMINI_API_KEYS is unset.
GEMINI_API_KEY=CHANGEME

# --- generation: pick one ---
# gemini = AI Studio (the API key above). vertex = Vertex AI (service account).
LLM_PROVIDER=gemini

# AI Studio model ids. Pinned on purpose: changing either requires a full
# check_answer.py re-run against results-baseline-aistudio-flash-lite-3.1.json.
GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_VISION_MODEL=gemini-3.6-flash

# --- Vertex AI, used only when LLM_PROVIDER=vertex ---
# Auth is a service account, not an API key: point GOOGLE_APPLICATION_CREDENTIALS
# at its JSON key file, or run somewhere with a default credential. The account
# needs roles/aiplatform.user.
#
# The model ids are NOT the same strings as AI Studio's -- 3.1 Flash-Lite is
# published on Vertex with a -preview suffix. There is no default worth
# guessing, so all four are required and startup refuses without them.
# check_reachable() then spends one tiny generation proving the id is real for
# this project, because a wrong id authenticates fine and 404s at answer time.
# GOOGLE_APPLICATION_CREDENTIALS=/etc/talkwisp/vertex-sa.json
# VERTEX_PROJECT=CHANGEME
# VERTEX_LOCATION=us-central1
# VERTEX_MODEL=gemini-3.1-flash-lite-preview
# VERTEX_VISION_MODEL=gemini-3.1-flash-lite-preview

# From @BotFather: /newbot. This is one BUSINESS's agent bot, not Talkwisp's
# platform bot -- the platform bot signs web logins and must never be a
# customer's. migrate.py copies this onto the business row the first time it
# runs; after that the row is the source of truth and the bot resolves which
# business it serves from the token itself. These two stay here only to
# bootstrap a new install.
TELEGRAM_BOT_TOKEN=CHANGEME
# Your numeric Telegram user id. Optional until step 23.
TELEGRAM_OWNER_ID=
